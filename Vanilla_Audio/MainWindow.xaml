<Window x:Class="Vanilla_Audio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vanilla_Audio"
        xmlns:converters="clr-namespace:Vanilla_Audio.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="225" Width="800">

    <Window.Resources>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200*"></ColumnDefinition>
            <ColumnDefinition Width="400*"></ColumnDefinition>
            <ColumnDefinition Width="199*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Pochette de la musique -->
        <Image Grid.Column="0" Source="{Binding CurrentSongCover, Converter={StaticResource ByteArrayToImageConverter}}"></Image>

        <!-- Panel du milieu avec boutons Play, Pause ... -->
        <StackPanel Grid.Column="1" Orientation="Vertical">
            <StackPanel>
                <Slider></Slider>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Randomize" Width="70"></Button>
                <Button Content="Skip Backward" Width="70" Click="SkipBackward_Click"></Button>
                <Button Content="Play/Pause" Width="70" Click="PlayPause_Click"></Button>
                <Button Content="Skip Forward" Width="70" Click="SkipForward_Click"></Button>
                <Button Content="Loop" Width="70"></Button>
            </StackPanel>
            <Slider x:Name="sliderVolume" Width="189" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/>
            <Label Content="{Binding Volume}"/>
            <Label Content="{Binding CurrentSongTitle}"/>
            <Label Content="{Binding CurrentSongArtist}"/>
        </StackPanel>
        
        <!-- Panel avec liste des chansons et boutons settings -->
        <StackPanel Grid.Column="2" Orientation="Vertical">
            <ListView x:Name="listViewSongs" Height="163" ItemsSource="{Binding Songs}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Image Width="40" Height="40" Source="{Binding Cover, Converter={StaticResource ByteArrayToImageConverter}}"/>
                            <StackPanel Orientation="Vertical" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Duration, StringFormat=mm\\:ss}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Content="Settings" Click="OpenSettings_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
